{
  "id": "io.github.tomsliikee.Anvil",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "anvil",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=network",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": [
      "--share=network"
    ],
    "env": {
      "CARGO_HOME": "/run/build/anvil/cargo",
      "CARGO_TARGET_DIR": "/run/build/anvil/target"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/vala",
    "/share/gir-1.0",
    "/bin/vte-2.91-gtk4"
  ],
  "modules": [
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-Dgir=false",
        "-Dvapi=false",
        "-Dglade=false",
        "-Ddocs=false",
        "-Dapp=false",
        "-D_systemd=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.1.tar.xz",
          "sha256": "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8"
        }
      ]
    },
    {
      "name": "anvil",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release -p anvil",
        "install -Dm755 /run/build/anvil/target/release/anvil /app/bin/anvil",
        "install -Dm644 data/io.github.tomsliikee.Anvil.desktop -t /app/share/applications",
        "install -Dm644 data/io.github.tomsliikee.Anvil.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 data/io.github.tomsliikee.Anvil.gschema.xml -t /app/share/glib-2.0/schemas",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "install -Dm644 data/icons/scalable/apps/io.github.tomsliikee.Anvil.svg -t /app/share/icons/hicolor/scalable/apps",
        "install -Dm644 data/sourceview/language-specs/*.lang -t /app/share/anvil/sourceview/language-specs",
        "install -Dm644 data/sourceview/styles/*.xml -t /app/share/anvil/sourceview/styles",
        "for lang in $(cat po/LINGUAS); do install -d /app/share/locale/$lang/LC_MESSAGES && msgfmt -o /app/share/locale/$lang/LC_MESSAGES/anvil.mo po/$lang.po; done",
        "install -Dm644 insights-mono/fonts/*.ttf -t /app/share/fonts/anvil",
        "install -Dm644 insights-mono/fonts/*.txt -t /app/share/licenses/io.github.tomsliikee.Anvil/fonts",
        "install -Dm644 LICENSE -t /app/share/licenses/io.github.tomsliikee.Anvil"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            "target-sdk",
            ".flatpak-builder",
            "build-dir",
            "repo",
            ".git",
            "readmestuff"
          ]
        }
      ]
    }
  ],
  "separate-locales": false
}
