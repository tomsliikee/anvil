<?xml version="1.0" encoding="UTF-8"?>
<!-- Anvil's code colours (Light): a muted palette on the card ground of
     insights-mono/tokens.json. Every colour reads at 4.5:1 or more on the
     ground. Keywords, strings and comments come from the language
     definition; anvil:type, anvil:method and anvil:property colour the
     names Anvil finds in the syntax tree (set in Cascadia Mono Italic). -->
<style-scheme id="anvil-light" name="Anvil Light" version="1.0">
  <style name="text" foreground="#1b1b20" background="#f4f4f6"/>
  <style name="selection" background="#d4dcf0"/>
  <style name="cursor" foreground="#1b1b20"/>
  <style name="current-line" background="#ececf0"/>
  <style name="line-numbers" foreground="#a3a3a8" background="#f4f4f6"/>
  <style name="current-line-number" foreground="#5e5e64" background="#f4f4f6" bold="true"/>
  <style name="background-pattern" background="#ececf0"/>
  <style name="draw-spaces" foreground="#e0e0e4"/>
  <style name="right-margin" foreground="#e0e0e4"/>
  <style name="bracket-match" background="#d4dcf0" bold="true"/>
  <style name="search-match" background="#d4dcf0" bold="true"/>
  <style name="snippet-focus" background="#ececf0" underline="single"/>
  <style name="def:keyword" foreground="#6b3fb0"/>
  <style name="def:type" foreground="#6b3fb0"/>
  <style name="def:function" foreground="#82540a"/>
  <style name="def:string" foreground="#2f7032"/>
  <style name="def:special-char" foreground="#985400"/>
  <style name="def:character" foreground="#2f7032"/>
  <style name="def:number" foreground="#a84c12"/>
  <style name="def:identifier" foreground="#1b1b20"/>
  <style name="def:comment" foreground="#6e6e76" italic="true"/>
  <style name="def:doc-comment-element" foreground="#6e6e76" bold="true"/>
  <style name="def:preprocessor" foreground="#5e5e64"/>
  <style name="def:error" underline="error" underline-color="#ba1a1a"/>
  <style name="def:warning" underline="error" underline-color="#5e5e64"/>
  <style name="anvil:type" foreground="#0d6f69" italic="true"/>
  <style name="anvil:method" foreground="#82540a" italic="true"/>
  <style name="anvil:property" foreground="#2a5c9a"/>
  <style name="diff:added-line" foreground="#1f7a3d"/>
  <style name="diff:removed-line" foreground="#ba1a1a"/>
  <style name="anvil-xml:tag" foreground="#0d6f69"/>
  <style name="anvil-xml:attribute" foreground="#2a5c9a"/>
  <style name="anvil-xml:value" foreground="#2f7032"/>
</style-scheme>
