<?xml version="1.0" encoding="UTF-8"?>
<!-- C# for Anvil (MIT). Written for Anvil; the GNOME runtime ships no
     language definitions. Semantic colouring (types, members) comes from
     Roslyn on top of this. -->
<language id="anvil-csharp" name="C#" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-csharp;text/x-csharpsrc</property>
    <property name="globs">*.cs;*.csx</property>
    <property name="line-comment-start">//</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>
  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="doc" name="Documentation" map-to="def:doc-comment-element"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="char" name="Character" map-to="def:character"/>
    <style id="escape" name="Escape" map-to="def:special-char"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="type" name="Type" map-to="def:type"/>
    <style id="preprocessor" name="Preprocessor" map-to="def:preprocessor"/>
  </styles>
  <definitions>
    <context id="escape" style-ref="escape">
      <match>\\(["'\\0abfnrtv]|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})</match>
    </context>
    <context id="doc-comment" style-ref="comment" end-at-line-end="true">
      <start>///</start>
      <include>
        <context id="doc-tag" style-ref="doc"><match>&lt;/?[A-Za-z]+[^&gt;]*&gt;</match></context>
      </include>
    </context>
    <context id="line-comment" style-ref="comment" end-at-line-end="true">
      <start>//</start>
    </context>
    <context id="block-comment" style-ref="comment">
      <start>/\*</start>
      <end>\*/</end>
    </context>
    <context id="raw-string" style-ref="string">
      <start>\$*"""</start>
      <end>"""</end>
    </context>
    <context id="verbatim-string" style-ref="string">
      <start>\$?@\$?"</start>
      <end>"</end>
      <include>
        <context id="double-quote" style-ref="escape"><match>""</match></context>
      </include>
    </context>
    <context id="string" style-ref="string" end-at-line-end="true">
      <start>\$?"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>
    <context id="char" style-ref="char">
      <match>'(\\.|\\u[0-9A-Fa-f]{4}|[^'\\])'</match>
    </context>
    <context id="number" style-ref="number">
      <match extended="true">(?&lt;![\w.])(0[xX][0-9A-Fa-f_]+|0[bB][01_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9]+)?)([uU]?[lL]?|[lL]?[uU]?|[fFdDmM])?(?![\w.])</match>
    </context>
    <context id="preprocessor" style-ref="preprocessor" end-at-line-end="true">
      <start>^\s*#\s*(if|else|elif|endif|define|undef|warning|error|line|region|endregion|pragma|nullable)\b</start>
    </context>
    <context id="types" style-ref="type">
      <keyword>bool</keyword><keyword>byte</keyword><keyword>char</keyword><keyword>decimal</keyword><keyword>double</keyword><keyword>dynamic</keyword><keyword>float</keyword><keyword>int</keyword><keyword>long</keyword><keyword>nint</keyword><keyword>nuint</keyword><keyword>object</keyword><keyword>sbyte</keyword><keyword>short</keyword><keyword>string</keyword><keyword>uint</keyword><keyword>ulong</keyword><keyword>ushort</keyword><keyword>var</keyword><keyword>void</keyword>
    </context>
    <context id="keywords" style-ref="keyword">
      <keyword>abstract</keyword><keyword>as</keyword><keyword>base</keyword><keyword>break</keyword><keyword>case</keyword><keyword>catch</keyword><keyword>checked</keyword><keyword>class</keyword><keyword>const</keyword><keyword>continue</keyword><keyword>default</keyword><keyword>delegate</keyword><keyword>do</keyword><keyword>else</keyword><keyword>enum</keyword><keyword>event</keyword><keyword>explicit</keyword><keyword>extern</keyword><keyword>false</keyword><keyword>finally</keyword><keyword>fixed</keyword><keyword>for</keyword><keyword>foreach</keyword><keyword>goto</keyword><keyword>if</keyword><keyword>implicit</keyword><keyword>in</keyword><keyword>interface</keyword><keyword>internal</keyword><keyword>is</keyword><keyword>lock</keyword><keyword>namespace</keyword><keyword>new</keyword><keyword>null</keyword><keyword>operator</keyword><keyword>out</keyword><keyword>override</keyword><keyword>params</keyword><keyword>private</keyword><keyword>protected</keyword><keyword>public</keyword><keyword>readonly</keyword><keyword>ref</keyword><keyword>return</keyword><keyword>sealed</keyword><keyword>sizeof</keyword><keyword>stackalloc</keyword><keyword>static</keyword><keyword>struct</keyword><keyword>switch</keyword><keyword>this</keyword><keyword>throw</keyword><keyword>true</keyword><keyword>try</keyword><keyword>typeof</keyword><keyword>unchecked</keyword><keyword>unsafe</keyword><keyword>using</keyword><keyword>virtual</keyword><keyword>volatile</keyword><keyword>while</keyword>
      <keyword>add</keyword><keyword>and</keyword><keyword>async</keyword><keyword>await</keyword><keyword>file</keyword><keyword>get</keyword><keyword>global</keyword><keyword>init</keyword><keyword>nameof</keyword><keyword>not</keyword><keyword>or</keyword><keyword>partial</keyword><keyword>record</keyword><keyword>remove</keyword><keyword>required</keyword><keyword>scoped</keyword><keyword>set</keyword><keyword>value</keyword><keyword>when</keyword><keyword>where</keyword><keyword>with</keyword><keyword>yield</keyword><keyword>field</keyword>
    </context>
    <context id="anvil-csharp" class="no-spell-check">
      <include>
        <context ref="doc-comment"/>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="raw-string"/>
        <context ref="verbatim-string"/>
        <context ref="string"/>
        <context ref="char"/>
        <context ref="number"/>
        <context ref="preprocessor"/>
        <context ref="types"/>
        <context ref="keywords"/>
      </include>
    </context>
  </definitions>
</language>
